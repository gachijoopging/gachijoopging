<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nav_item_selector"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <!-- 라벨이 의미를 전달하므로 아이콘은 장식 처리 -->
    <ImageView
        android:id="@+id/icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_home"
        app:tint="@color/selector_nav_item" />

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:duplicateParentState="true"
        android:text="@string/nav_home"
        android:textColor="@color/selector_nav_item"
        android:textSize="@dimen/text_micro"
        android:textStyle="bold" />
</LinearLayout>
