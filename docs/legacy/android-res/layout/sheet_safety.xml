<?xml version="1.0" encoding="utf-8"?>
<!-- 신고 / 차단 시트 (M09, M17, M20 공통) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_2xl">

    <View style="@style/Gachi.SheetHandle" />

    <TextView
        android:id="@+id/title"
        style="@style/Gachi.Text.Section.Lg"
        android:layout_marginTop="@dimen/space_md" />

    <TextView
        android:id="@+id/desc"
        style="@style/Gachi.Text.Body"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_sm"
        android:textColor="@color/gachi_ink_muted"
        android:textSize="@dimen/text_label" />

    <LinearLayout
        android:id="@+id/reportRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_tile_round"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_avatar"
            android:backgroundTint="@color/gachi_warn_bg"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="🚨"
            android:textSize="@dimen/text_subtitle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Text.ItemName"
                android:text="@string/act_manage_report" />

            <TextView
                style="@style/Gachi.Text.Caption"
                android:text="@string/act_manage_report_desc" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/blockRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_tile_round"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_danger"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="⛔"
            android:textSize="@dimen/text_subtitle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Text.ItemName"
                android:text="@string/act_manage_block"
                android:textColor="@color/gachi_danger_ink" />

            <TextView
                style="@style/Gachi.Text.Caption"
                android:text="@string/act_manage_block_desc" />
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/closeButton"
        style="@style/Gachi.Button.Ghost"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/action_close"
        android:textSize="@dimen/text_body_lg" />
</LinearLayout>
