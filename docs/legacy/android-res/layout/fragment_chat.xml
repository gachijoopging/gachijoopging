<?xml version="1.0" encoding="utf-8"?>
<!-- M33 단체 채팅방 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg"
        android:scrollbars="none" />

    <LinearLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_xl">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/input"
            style="@style/Gachi.Input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:elevation="2dp"
            android:outlineAmbientShadowColor="@color/gachi_shadow"
            android:outlineSpotShadowColor="@color/gachi_shadow"
            android:hint="@string/hint_message"
            android:paddingStart="@dimen/space_xl"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_lg"
            android:textSize="@dimen/text_body" />

        <ImageButton
            android:id="@+id/sendButton"
            style="@style/Gachi.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_circle_lime"
            android:contentDescription="@string/cd_send"
            android:elevation="6dp"
            android:padding="@dimen/space_lg"
            android:src="@drawable/ic_send" />
    </LinearLayout>
</LinearLayout>
