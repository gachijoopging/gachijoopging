<?xml version="1.0" encoding="utf-8"?>
<!-- M31 비밀번호 재설정 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <!-- 발송 전 -->
    <ScrollView
        android:id="@+id/formState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Text.PageTitle"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="@string/pw_headline"
                android:textSize="22sp" />

            <TextView
                style="@style/Gachi.Text.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xs"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="@string/pw_desc" />

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@+id/emailInput"
                android:text="@string/label_email" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/emailInput"
                style="@style/Gachi.Input"
                android:layout_marginTop="@dimen/space_sm"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress" />

            <TextView
                android:id="@+id/emailError"
                style="@style/Gachi.Text.FieldError"
                android:layout_marginTop="@dimen/space_sm" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/sendButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_button_cta"
                android:enabled="false"
                android:text="@string/pw_send" />
        </LinearLayout>
    </ScrollView>

    <!-- 발송 후 -->
    <LinearLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:id="@+id/sentState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_2xl"
        android:paddingEnd="@dimen/space_2xl"
        android:visibility="gone">

        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_surface"
            android:elevation="3dp"
            android:outlineAmbientShadowColor="@color/gachi_shadow"
            android:outlineSpotShadowColor="@color/gachi_shadow"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="✉️"
            android:textSize="28sp" />

        <TextView
            style="@style/Gachi.Text.Section.Lg"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/pw_sent_title" />

        <TextView
            android:id="@+id/sentDesc"
            style="@style/Gachi.Text.Caption"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:lineSpacingMultiplier="1.6" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/resendButton"
            style="@style/Gachi.Button.Ghost.Compact"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/pw_send_again"
            android:textSize="@dimen/text_body" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/toLoginButton"
            style="@style/Gachi.Button.Primary.Compact"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/pw_to_login"
            android:textSize="@dimen/text_body" />
    </LinearLayout>
</LinearLayout>
