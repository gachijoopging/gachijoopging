<?xml version="1.0" encoding="utf-8"?>
<!-- M25 수거 항목 수정 시트 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_2xl">

    <View style="@style/Gachi.SheetHandle" />

    <TextView
        style="@style/Gachi.Text.Section.Lg"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/rd_edit_title" />

    <TextView
        style="@style/Gachi.Text.Body"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/rd_edit_desc"
        android:textColor="@color/gachi_ink_muted"
        android:textSize="@dimen/text_label" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_lg"
        android:background="@drawable/bg_tile_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_xs">

        <ImageButton
            android:id="@+id/minusButton"
            style="@style/Gachi.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_surface_40"
            android:contentDescription="@string/cd_capacity_minus"
            android:padding="@dimen/space_lg"
            android:src="@drawable/ic_minus" />

        <TextView
            android:id="@+id/value"
            style="@style/Gachi.Text.Section"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_md"
            android:gravity="center"
            android:minWidth="52dp"
            android:textSize="@dimen/text_title" />

        <ImageButton
            android:id="@+id/plusButton"
            style="@style/Gachi.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_deep_40"
            android:contentDescription="@string/cd_capacity_plus"
            android:padding="@dimen/space_lg"
            android:src="@drawable/ic_plus"
            app:tint="@color/gachi_yellow" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/saveButton"
        style="@style/Gachi.Button.Primary"
        android:layout_marginTop="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg"
        android:text="@string/rd_edit_save" />
</LinearLayout>
