<?xml version="1.0" encoding="utf-8"?>
<!-- M21 친구 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabFriends"
            style="@style/Gachi.Tab"
            android:text="@string/fl_tab_friend" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabIncoming"
            style="@style/Gachi.Tab"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/fl_tab_incoming" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/view_loading" />

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Gachi.Text.Micro"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_sm"
                android:lineSpacingMultiplier="1.4"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/fl_note"
                android:textColor="@color/gachi_ink_faint" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
