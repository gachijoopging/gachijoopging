<?xml version="1.0" encoding="utf-8"?>
<!-- M25 기록 상세 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="170dp">

                <include
                    android:id="@+id/map"
                    layout="@layout/view_map_frame" />

                <TextView
                    android:id="@+id/gpsChip"
                    style="@style/Gachi.Chip.Static.Warn"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/space_md"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/rd_gps_weak"
                    android:textSize="@dimen/text_micro"
                    android:visibility="gone" />
            </FrameLayout>

            <include
                android:id="@+id/metrics"
                layout="@layout/view_metric_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <TextView
                android:id="@+id/zeroChip"
                style="@style/Gachi.Chip.Static.Warn"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/rd_zero"
                android:visibility="gone" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/categoryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:flexWrap="wrap" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/editItems"
                style="@style/Gachi.Button.Link"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/rd_edit_items" />

            <LinearLayout
                android:id="@+id/albumCard"
                style="@style/Gachi.Card"
                android:layout_marginTop="@dimen/space_md"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Gachi.Text.Section.Sm"
                        android:text="@string/rd_album_title" />

                    <TextView
                        style="@style/Gachi.Text.Micro"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_marginBottom="1dp"
                        android:text="@string/rd_album_hint"
                        android:textColor="@color/gachi_ink_faint"
                        android:textStyle="normal" />
                </LinearLayout>

                <site.gachijoopging.app.ui.common.ClipOutlineFrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_photo_placeholder">

                    <!-- 서버에 저장된 활동 사진. 없으면 아래 플레이스홀더가 보인다. -->
                    <ImageView
                        android:id="@+id/heroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/heroPlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_photo"
                            app:tint="@color/gachi_ink_65" />

                        <TextView
                            android:id="@+id/heroLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textColor="@color/gachi_ink_65"
                            android:textSize="@dimen/text_label"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/photoIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/space_md"
                        android:background="@drawable/bg_pill_overlay"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="@dimen/space_xs"
                        android:textColor="@color/gachi_on_dark"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/prevPhoto"
                        style="@style/Gachi.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="0dp"
                        android:background="@drawable/bg_circle_surface_32"
                        android:contentDescription="@string/cd_photo_prev"
                        android:padding="@dimen/space_lg"
                        android:src="@drawable/ic_back"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/nextPhoto"
                        style="@style/Gachi.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="0dp"
                        android:background="@drawable/bg_circle_surface_32"
                        android:contentDescription="@string/cd_photo_next"
                        android:padding="@dimen/space_lg"
                        android:src="@drawable/ic_chevron_right"
                        android:visibility="gone" />
                </site.gachijoopging.app.ui.common.ClipOutlineFrameLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/thumbRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_xs" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/reorderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/moveLeft"
                        style="@style/Gachi.Chip.Choice"
                        android:text="@string/rd_move_left" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/makeFirst"
                        style="@style/Gachi.Chip.Choice"
                        android:layout_marginStart="@dimen/space_sm"
                        android:text="@string/rd_make_first" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/moveRight"
                        style="@style/Gachi.Chip.Choice"
                        android:layout_marginStart="@dimen/space_sm"
                        android:text="@string/rd_move_right" />
                </LinearLayout>

                <TextView
                    style="@style/Gachi.Text.Micro"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_md"
                    android:lineSpacingMultiplier="1.4"
                    android:text="@string/rd_album_note"
                    android:textColor="@color/gachi_ink_faint" />
            </LinearLayout>

            <TextView
                android:id="@+id/noAlbum"
                style="@style/Gachi.Text.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/rd_no_album"
                android:textColor="@color/gachi_ink_faint"
                android:visibility="gone" />

            <TextView
                android:id="@+id/linkChip"
                style="@style/Gachi.Chip.Static.Info"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/rd_linked" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/shareButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/rd_share" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
