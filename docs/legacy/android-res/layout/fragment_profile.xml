<?xml version="1.0" encoding="utf-8"?>
<!-- M08 프로필 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Gachi.Text.PageTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/profile_title" />

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/Gachi.IconButton"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <LinearLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_xs">

        <TextView
            android:id="@+id/face"
            style="@style/Gachi.Avatar.Large"
            android:contentDescription="@string/cd_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                style="@style/Gachi.Text.PageTitle"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/area"
                style="@style/Gachi.Text.Caption"
                android:layout_marginTop="@dimen/space_xs" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/friendCount"
                style="@style/Gachi.Button.Link"
                android:layout_marginTop="@dimen/space_xs"
                android:padding="@dimen/space_xs"
                android:textColor="@color/gachi_ink_muted"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/editButton"
            style="@style/Gachi.Button.Primary.Compact"
            android:layout_gravity="top"
            android:background="@drawable/bg_search_pill"
            android:elevation="2dp"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_md"
            android:text="@string/profile_edit"
            android:textSize="@dimen/text_label" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/upcomingSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs">

            <TextView
                style="@style/Gachi.Text.Caption.Strong"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/profile_upcoming" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/upcomingAll"
                style="@style/Gachi.Button.Link"
                android:text="@string/profile_upcoming_all" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/upcomingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_card_translucent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_md">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_marker_soft"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_calendar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/upcomingTitle"
                    style="@style/Gachi.Text.ItemName" />

                <TextView
                    android:id="@+id/upcomingMeta"
                    style="@style/Gachi.Text.Caption" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/gachi_ink_hint" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabRecord"
            style="@style/Gachi.Tab"
            android:text="@string/profile_tab_record" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabFeed"
            style="@style/Gachi.Tab"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/profile_tab_feed" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/nav_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/recordList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/postGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
