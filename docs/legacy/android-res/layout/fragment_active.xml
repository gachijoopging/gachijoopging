<?xml version="1.0" encoding="utf-8"?>
<!-- M09 줍깅 활동중 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gachi_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <include
        android:id="@+id/map"
        layout="@layout/view_map_frame" />

    <!-- 상단 오버레이 -->
    <LinearLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_xl"
        android:orientation="vertical">

        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/activityLabel"
                style="@style/Gachi.Chip.Static.Deep"
                android:drawableStart="@drawable/ic_person_small"
                android:drawablePadding="6dp"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="@color/gachi_shadow"
                android:outlineSpotShadowColor="@color/gachi_shadow"
                android:fontFamily="@font/pretendard"
                android:textStyle="bold"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_sm"
                android:textSize="@dimen/text_label" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/memberPill"
                style="@style/Gachi.Chip.Choice"
                android:layout_marginStart="@dimen/space_sm"
                android:drawableStart="@drawable/ic_people_small"
                android:drawablePadding="6dp"
                android:visibility="gone"
                app:drawableTint="@color/selector_chip_text" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/endButton"
                style="@style/Gachi.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:elevation="4dp"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/act_end"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <include
            android:id="@+id/metrics"
            layout="@layout/view_metric_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" />

        <TextView
            android:id="@+id/gpsChip"
            style="@style/Gachi.Chip.Static.Warn"
            android:layout_marginTop="@dimen/space_md"
            android:elevation="3dp"
            android:outlineAmbientShadowColor="@color/gachi_shadow"
            android:outlineSpotShadowColor="@color/gachi_shadow"
            android:text="@string/act_gps_weak"
            android:visibility="gone" />

        <TextView
            android:id="@+id/offlineChip"
            style="@style/Gachi.Chip.Static.Warn"
            android:layout_marginTop="@dimen/space_md"
            android:elevation="3dp"
            android:outlineAmbientShadowColor="@color/gachi_shadow"
            android:outlineSpotShadowColor="@color/gachi_shadow"
            android:text="@string/act_offline"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 수거 목록 열기 -->
    <LinearLayout
        android:id="@+id/pickupChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginBottom="122dp"
        android:background="@drawable/bg_search_pill"
        android:elevation="6dp"
        android:outlineAmbientShadowColor="@color/gachi_shadow"
        android:outlineSpotShadowColor="@color/gachi_shadow"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_trash"
            app:tint="@color/gachi_deep" />

        <TextView
            android:id="@+id/pickupChipLabel"
            style="@style/Gachi.Text.Section"
            android:layout_marginStart="@dimen/space_sm"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/unclassBadge"
            style="@style/Gachi.Chip.Static.Warn"
            android:layout_marginStart="@dimen/space_sm"
            android:paddingStart="@dimen/space_sm"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_xs"
            android:textSize="@dimen/text_micro"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 하단 바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_lg"
        android:background="@drawable/bg_bottom_nav"
        android:clipChildren="false"
        android:elevation="10dp"
        android:outlineAmbientShadowColor="@color/gachi_shadow"
        android:outlineSpotShadowColor="@color/gachi_shadow">

        <LinearLayout
            android:id="@+id/groupButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_pill"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.13"
            app:layout_constraintEnd_toStartOf="@id/captureWrap">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_neutral"
                    android:contentDescription="@null"
                    android:padding="@dimen/space_md"
                    android:src="@drawable/ic_people"
                    app:tint="@color/gachi_neutral_ink" />

                <View
                    android:id="@+id/groupDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_unread_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                style="@style/Gachi.Text.Micro"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/act_group"
                android:textColor="@color/gachi_ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/captureWrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/captureButton"
                android:layout_width="@dimen/capture_fab"
                android:layout_height="@dimen/capture_fab"
                android:layout_marginTop="-34dp"
                android:background="@drawable/bg_capture_fab"
                android:contentDescription="@string/act_capture"
                android:elevation="8dp"
                android:outlineAmbientShadowColor="@color/gachi_shadow_lime"
                android:outlineSpotShadowColor="@color/gachi_shadow_lime"
                android:padding="@dimen/space_2xl"
                android:src="@drawable/ic_camera"
                app:tint="@color/gachi_on_lime" />

            <TextView
                style="@style/Gachi.Text.Section"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/act_capture"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/voiceButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_pill"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.87"
            app:layout_constraintStart_toEndOf="@id/captureWrap"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/voiceIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_neutral"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_md"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/voiceLabel"
                style="@style/Gachi.Text.Micro"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/gachi_ink" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
