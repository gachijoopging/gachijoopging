<?xml version="1.0" encoding="utf-8"?>
<!-- M28 모임 정보 수정 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lockedBanner"
                style="@style/Gachi.Chip.Static.Danger"
                android:layout_width="match_parent"
                android:background="@drawable/bg_banner_danger"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_md"
                android:text="@string/med_locked"
                android:textSize="@dimen/text_label"
                android:visibility="gone" />

            <TextView
                android:id="@+id/openNote"
                style="@style/Gachi.Text.Caption"
                android:layout_width="match_parent"
                android:lineSpacingMultiplier="1.45"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/med_open" />

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@+id/titleInput"
                android:text="@string/label_meet_name" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/titleInput"
                style="@style/Gachi.Input"
                android:layout_marginTop="@dimen/space_sm" />

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@+id/timeInput"
                android:text="@string/label_time" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/timeInput"
                style="@style/Gachi.Input"
                android:layout_marginTop="@dimen/space_sm" />

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/label_visibility" />

            <LinearLayout
                android:id="@+id/visibilityList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/saveButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_button_cta"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_lg"
                android:text="@string/med_save"
                android:textSize="@dimen/text_body_lg" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
