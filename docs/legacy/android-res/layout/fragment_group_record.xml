<?xml version="1.0" encoding="utf-8"?>
<!-- M26 모임 기록 상세 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabMine"
            style="@style/Gachi.Tab"
            android:text="@string/gr_tab_mine" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabWhole"
            style="@style/Gachi.Tab"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/gr_tab_whole" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <include
                    android:id="@+id/map"
                    layout="@layout/view_map_frame" />

                <TextView
                    android:id="@+id/gpsChip"
                    style="@style/Gachi.Chip.Static.Warn"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/space_md"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/rd_gps_weak"
                    android:textSize="@dimen/text_micro"
                    android:visibility="gone" />
            </FrameLayout>

            <include
                android:id="@+id/metrics"
                layout="@layout/view_metric_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/categoryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:flexWrap="wrap" />

            <LinearLayout
                android:id="@+id/shareBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_tile_round"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_md"
                android:visibility="gone">

                <TextView
                    android:id="@+id/myShare"
                    style="@style/Gachi.Text.Section.Sm" />

                <TextView
                    android:id="@+id/myShareSub"
                    style="@style/Gachi.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_xs" />
            </LinearLayout>

            <TextView
                android:id="@+id/wholeNote"
                style="@style/Gachi.Text.Micro"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_sm"
                android:lineSpacingMultiplier="1.4"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/gr_whole_note"
                android:textColor="@color/gachi_ink_faint"
                android:visibility="gone" />

            <LinearLayout
                style="@style/Gachi.Card"
                android:layout_marginTop="@dimen/space_md">

                <TextView
                    android:id="@+id/memberCount"
                    style="@style/Gachi.Text.Section.Sm"
                    android:layout_marginBottom="@dimen/space_md" />

                <LinearLayout
                    android:id="@+id/memberList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/shareButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/gr_share" />

            <TextView
                style="@style/Gachi.Text.Micro"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_sm"
                android:lineSpacingMultiplier="1.4"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/gr_share_note"
                android:textColor="@color/gachi_ink_faint" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
