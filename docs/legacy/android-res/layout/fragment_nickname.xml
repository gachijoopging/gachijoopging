<?xml version="1.0" encoding="utf-8"?>
<!-- M03 프로필 설정 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Chip.Static.Deep"
                android:text="@string/nick_badge"
                android:textSize="@dimen/text_label" />

            <TextView
                style="@style/Gachi.Text.PageTitle"
                android:layout_marginTop="@dimen/space_sm"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="@string/nick_headline"
                android:textSize="24sp" />

            <TextView
                style="@style/Gachi.Text.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xs"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="@string/nick_desc" />

            <LinearLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:id="@+id/photoPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_tile"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_sm">

                <TextView
                    android:id="@+id/photoSlot"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:background="@drawable/bg_dashed_circle"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="@color/gachi_shadow"
                    android:outlineSpotShadowColor="@color/gachi_shadow"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/nick_photo_slot"
                    android:textColor="@color/gachi_ink_faint"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    style="@style/Gachi.Text.Caption.Strong"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/nick_pick_photo" />
            </LinearLayout>

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_sm"
                android:labelFor="@+id/nicknameInput"
                android:text="@string/label_nickname" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/nicknameInput"
                    style="@style/Gachi.Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_nickname"
                    android:maxLength="12" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/checkButton"
                    style="@style/Gachi.Button.Deep"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/bg_button_deep_field"
                    android:foreground="@drawable/ripple_field"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg"
                    android:text="@string/action_check_dup" />
            </LinearLayout>

            <TextView
                android:id="@+id/nicknameHint"
                style="@style/Gachi.Text.FieldError"
                android:layout_marginTop="@dimen/space_sm" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/nextButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/action_next" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
