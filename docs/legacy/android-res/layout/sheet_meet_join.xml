<?xml version="1.0" encoding="utf-8"?>
<!-- M06 활동 카드 탭 → 참여 요청 시트 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_2xl">

    <View style="@style/Gachi.SheetHandle" />

    <TextView
        android:id="@+id/title"
        style="@style/Gachi.Text.Section.Lg"
        android:layout_marginTop="@dimen/space_md" />

    <TextView
        android:id="@+id/meta"
        style="@style/Gachi.Text.Caption"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_sm"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/note"
        style="@style/Gachi.Text.Body"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_tile"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md" />

    <TextView
        android:id="@+id/fullNote"
        style="@style/Gachi.Text.Caption"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/meet_full_desc"
        android:textColor="@color/gachi_warn_ink"
        android:visibility="gone" />

    <!-- 대기 중 -->
    <LinearLayout
        android:id="@+id/pendingBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_banner_info"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md"
        android:visibility="gone">

        <TextView
            style="@style/Gachi.Text.ItemName"
            android:text="@string/meet_pending_title"
            android:textColor="@color/gachi_info_ink" />

        <TextView
            style="@style/Gachi.Text.Caption"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/meet_pending_desc"
            android:textColor="@color/gachi_info_ink" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/demoAccept"
                style="@style/Gachi.Button.Link"
                android:text="@string/meet_demo_accept"
                android:textColor="@color/gachi_info_ink" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/demoDecline"
                style="@style/Gachi.Button.Link"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/meet_demo_decline"
                android:textColor="@color/gachi_info_ink" />
        </LinearLayout>
    </LinearLayout>

    <!-- 거절됨 -->
    <LinearLayout
        android:id="@+id/declinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_banner_warn"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md"
        android:visibility="gone">

        <TextView
            style="@style/Gachi.Text.ItemName"
            android:text="@string/meet_declined_title"
            android:textColor="@color/gachi_warn_ink" />

        <TextView
            style="@style/Gachi.Text.Caption"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/meet_declined_desc"
            android:textColor="@color/gachi_warn_ink" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/requestButton"
        style="@style/Gachi.Button.Primary"
        android:layout_marginTop="@dimen/space_md"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg"
        android:text="@string/meet_join_request" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/closeButton"
        style="@style/Gachi.Button.Ghost"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/action_close" />
</LinearLayout>
