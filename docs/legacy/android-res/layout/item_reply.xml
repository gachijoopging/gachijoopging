<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:background="@drawable/bg_reply_bubble"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_md"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/space_md"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/face"
        style="@style/Gachi.Avatar.Small"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/Gachi.Text.ItemName"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/text"
            style="@style/Gachi.Text.Body"
            android:layout_width="match_parent"
            android:layout_marginTop="1dp"
            android:lineSpacingMultiplier="1.5"
            android:textSize="@dimen/text_label" />
    </LinearLayout>
</LinearLayout>
