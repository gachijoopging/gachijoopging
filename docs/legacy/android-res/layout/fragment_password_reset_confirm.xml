<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include android:id="@+id/header" layout="@layout/view_screen_header" />

    <TextView
        style="@style/Gachi.Text.PageTitle"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/pw_confirm_headline" />

    <TextView
        style="@style/Gachi.Text.Label"
        android:layout_marginTop="@dimen/space_lg"
        android:labelFor="@+id/passwordInput"
        android:text="@string/label_password" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/passwordInput"
        style="@style/Gachi.Input"
        android:layout_marginTop="@dimen/space_sm"
        android:autofillHints="newPassword"
        android:hint="@string/hint_password"
        android:inputType="textPassword" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/togglePassword"
        style="@style/Gachi.Button.Ghost.Compact"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/pw_show" />

    <TextView
        style="@style/Gachi.Text.Label"
        android:layout_marginTop="@dimen/space_md"
        android:labelFor="@+id/passwordConfirmInput"
        android:text="@string/pw_confirm_label" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/passwordConfirmInput"
        style="@style/Gachi.Input"
        android:layout_marginTop="@dimen/space_sm"
        android:autofillHints="newPassword"
        android:hint="@string/pw_confirm_hint"
        android:inputType="textPassword" />

    <TextView
        android:id="@+id/error"
        style="@style/Gachi.Text.FieldError"
        android:layout_marginTop="@dimen/space_sm"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/confirmButton"
        style="@style/Gachi.Button.Primary"
        android:layout_marginTop="@dimen/space_lg"
        android:enabled="false"
        android:text="@string/pw_confirm_action" />
</LinearLayout>
