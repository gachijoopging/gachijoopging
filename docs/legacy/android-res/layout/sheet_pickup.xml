<?xml version="1.0" encoding="utf-8"?>
<!-- 이번 활동 수거 목록 (M09 pickupSheetOn) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_2xl">

    <View style="@style/Gachi.SheetHandle" />

    <TextView
        android:id="@+id/title"
        style="@style/Gachi.Text.Section.Lg"
        android:layout_marginTop="@dimen/space_md" />

    <TextView
        android:id="@+id/emptyText"
        style="@style/Gachi.Text.Caption"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/pickup_empty"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:minHeight="140dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/unclassHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    style="@style/Gachi.Text.Micro"
                    android:text="@string/pickup_need_class"
                    android:textColor="@color/gachi_warn_ink" />

                <TextView
                    android:id="@+id/unclassCount"
                    style="@style/Gachi.Chip.Static.Warn"
                    android:layout_marginStart="@dimen/space_sm"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_xs"
                    android:textSize="@dimen/text_micro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/unclassList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/statsHeader"
                style="@style/Gachi.Text.Micro"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/pickup_classified"
                android:textColor="@color/gachi_ink_muted"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/statsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/closeButton"
        style="@style/Gachi.Button.Primary"
        android:layout_marginTop="@dimen/space_md"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg"
        android:text="@string/action_close" />
</LinearLayout>
