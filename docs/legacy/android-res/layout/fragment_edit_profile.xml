<?xml version="1.0" encoding="utf-8"?>
<!-- M24 프로필 편집 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_2xl"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:id="@+id/photoPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_tile"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="@dimen/space_md">

                <TextView
                    android:id="@+id/photoSlot"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:background="@drawable/bg_dashed_circle"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="@color/gachi_shadow"
                    android:outlineSpotShadowColor="@color/gachi_shadow"
                    android:gravity="center"
                    android:textSize="36sp" />

                <TextView
                    style="@style/Gachi.Text.Caption.Strong"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/ep_change_photo" />
            </LinearLayout>

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_sm"
                android:labelFor="@+id/nicknameInput"
                android:text="@string/label_nickname" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/nicknameInput"
                    style="@style/Gachi.Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:maxLength="12" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/checkButton"
                    style="@style/Gachi.Button.Deep"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/bg_button_deep_field"
                    android:foreground="@drawable/ripple_field"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg"
                    android:text="@string/action_check_dup" />
            </LinearLayout>

            <TextView
                android:id="@+id/hint"
                style="@style/Gachi.Text.FieldError"
                android:layout_marginTop="@dimen/space_sm" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/saveButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/action_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
