<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <TextView
        style="@style/Gachi.Text.PageTitle"
        android:gravity="center"
        android:text="@string/location_gate_title" />

    <TextView
        style="@style/Gachi.Text.Body"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="center"
        android:text="@string/location_gate_desc" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/allowButton"
        style="@style/Gachi.Button.Primary"
        android:layout_marginTop="@dimen/space_2xl"
        android:text="@string/location_gate_allow"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/settingsButton"
        style="@style/Gachi.Button.Primary"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/location_gate_settings"
        android:visibility="gone" />
</LinearLayout>
