<?xml version="1.0" encoding="utf-8"?>
<!-- M23 설정 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="44dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Gachi.Card"
                android:padding="@dimen/space_sm">

                <include
                    android:id="@+id/rowProfile"
                    layout="@layout/view_settings_row" />

                <View style="@style/Gachi.Divider" />

                <include
                    android:id="@+id/rowHood"
                    layout="@layout/view_settings_row" />

                <View style="@style/Gachi.Divider" />

                <include
                    android:id="@+id/rowMap"
                    layout="@layout/view_settings_row" />

                <View style="@style/Gachi.Divider" />

                <include
                    android:id="@+id/rowBlocklist"
                    layout="@layout/view_settings_row" />
            </LinearLayout>

            <LinearLayout
                style="@style/Gachi.Card"
                android:layout_marginTop="@dimen/space_md"
                android:padding="@dimen/space_sm">

                <include
                    android:id="@+id/rowPassword"
                    layout="@layout/view_settings_row" />

                <View style="@style/Gachi.Divider" />

                <include
                    android:id="@+id/rowLogout"
                    layout="@layout/view_settings_row" />

                <View style="@style/Gachi.Divider" />

                <include
                    android:id="@+id/rowWithdraw"
                    layout="@layout/view_settings_row" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
