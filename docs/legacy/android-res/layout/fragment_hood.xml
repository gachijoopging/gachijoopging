<?xml version="1.0" encoding="utf-8"?>
<!-- M04 우리 동네 설정 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding"
    android:paddingBottom="@dimen/plain_scroll_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Chip.Static.Deep"
                android:text="@string/hood_badge"
                android:textSize="@dimen/text_label" />

            <TextView
                style="@style/Gachi.Text.PageTitle"
                android:layout_marginTop="@dimen/space_sm"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="@string/hood_headline"
                android:textSize="24sp" />

            <TextView
                style="@style/Gachi.Text.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xs"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="@string/hood_desc" />

            <LinearLayout
                android:id="@+id/grantedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card_sm"
                android:elevation="3dp"
                android:outlineAmbientShadowColor="@color/gachi_shadow"
                android:outlineSpotShadowColor="@color/gachi_shadow"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_lg"
                android:visibility="gone">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_thumb_square"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/space_md"
                    android:src="@drawable/ic_pin" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Gachi.Text.Micro"
                        android:text="@string/hood_current_label"
                        android:textColor="@color/gachi_ink_faint" />

                    <TextView
                        android:id="@+id/grantedName"
                        style="@style/Gachi.Text.ItemName"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    app:tint="@color/gachi_green_strong" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/findByGps"
                style="@style/Gachi.Button.Ghost"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/hood_find_by_gps"
                android:textSize="@dimen/text_body_lg" />

            <LinearLayout
                android:id="@+id/deniedBanner"
                style="@style/Gachi.Banner"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone">

                <TextView
                    style="@style/Gachi.Banner.Text"
                    android:text="@string/hood_denied"
                    android:textColor="@color/gachi_warn_ink" />
            </LinearLayout>

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@+id/hoodInput"
                android:text="@string/label_hood_search" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_md">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@string/cd_search"
                    android:src="@drawable/ic_search"
                    app:tint="@color/gachi_ink_muted" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/hoodInput"
                    style="@style/Gachi.Input.Search"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:hint="@string/hint_hood_search"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <TextView
                android:id="@+id/searching"
                style="@style/Gachi.Text.Caption"
                android:layout_marginTop="@dimen/space_sm"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="@string/hood_searching"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/candidateList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <include
                android:id="@+id/noResult"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                style="@style/Gachi.Banner"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_banner_tint">

                <TextView
                    style="@style/Gachi.Banner.Text"
                    android:text="@string/hood_privacy"
                    android:textColor="@color/gachi_ink_muted"
                    android:textStyle="normal" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 검색 결과 10건이면 스크롤 안의 확정 버튼은 화면 밖으로 밀려난다 — 아래 고정한다 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/doneButton"
        style="@style/Gachi.Button.Primary"
        android:background="@drawable/bg_button_cta"
        android:enabled="false"
        android:text="@string/hood_cta"
        android:textSize="@dimen/text_body_lg" />
</LinearLayout>
