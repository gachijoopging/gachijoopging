<?xml version="1.0" encoding="utf-8"?>
<!-- 제목 + 설명 + CTA 하나로 끝나는 단순 안내 시트 (사진 선택, 카메라 권한, 동네 변경 등) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_2xl">

    <View style="@style/Gachi.SheetHandle" />

    <TextView
        android:id="@+id/sheetTitle"
        style="@style/Gachi.Text.Section.Lg"
        android:layout_marginTop="@dimen/space_md" />

    <TextView
        android:id="@+id/sheetDesc"
        style="@style/Gachi.Text.Body"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_sm"
        android:textColor="@color/gachi_ink_muted" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/sheetCta"
        style="@style/Gachi.Button.Primary"
        android:layout_marginTop="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg" />
</LinearLayout>
