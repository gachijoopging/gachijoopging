<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/face"
        style="@style/Gachi.Avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:textSize="@dimen/text_subtitle" />

    <LinearLayout
        android:id="@+id/bubbleColumn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/Gachi.Text.Caption.Strong"
            android:paddingStart="@dimen/space_xs" />

        <TextView
            android:id="@+id/bubble"
            style="@style/Gachi.Text.Body"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_bubble_other"
            android:maxWidth="260dp"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_md" />

        <TextView
            android:id="@+id/time"
            style="@style/Gachi.Text.Micro"
            android:layout_marginTop="@dimen/space_xs"
            android:paddingStart="@dimen/space_xs" />
    </LinearLayout>
</LinearLayout>
