<?xml version="1.0" encoding="utf-8"?>
<!--
  M25 수거 항목 편집 시트.

  확정 스펙상 총개수는 항목에서 파생되는 값이라 직접 고칠 수 없습니다.
  대신 항목을 수정·삭제·추가하면 서버가 개수와 카테고리 요약을 다시 계산합니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_2xl">

    <View style="@style/Gachi.SheetHandle" />

    <TextView
        style="@style/Gachi.Text.Section.Lg"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/rd_items_title" />

    <TextView
        style="@style/Gachi.Text.Body"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/rd_items_desc"
        android:textColor="@color/gachi_ink_muted"
        android:textSize="@dimen/text_label" />

    <TextView
        android:id="@+id/emptyLabel"
        style="@style/Gachi.Text.Body"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center"
        android:text="@string/rd_items_empty"
        android:textColor="@color/gachi_ink_faint"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/itemList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/addLabel"
        style="@style/Gachi.Text.Body"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/rd_items_add"
        android:textStyle="bold" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/addRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        app:flexWrap="wrap"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:id="@+id/doneButton"
        style="@style/Gachi.Button.Primary"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/action_done" />
</LinearLayout>
