<?xml version="1.0" encoding="utf-8"?>
<!-- M02 이메일 로그인 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_3xl"
                android:paddingBottom="@dimen/space_sm">

                <ImageView
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="36dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/cd_logo"
                    android:src="@drawable/img_logo_wordmark" />

                <TextView
                    style="@style/Gachi.Text.PageTitle"
                    android:text="@string/login_headline"
                    android:textSize="24sp" />

                <TextView
                    style="@style/Gachi.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6"
                    android:text="@string/login_desc"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="28dp"
                android:labelFor="@+id/emailInput"
                android:text="@string/label_email" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/emailInput"
                style="@style/Gachi.Input"
                android:layout_marginTop="@dimen/space_sm"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress" />

            <TextView
                android:id="@+id/emailError"
                style="@style/Gachi.Text.FieldError"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/err_email_format" />

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@+id/passwordInput"
                android:text="@string/label_password" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/passwordInput"
                    style="@style/Gachi.Input"
                    android:autofillHints="password"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:paddingEnd="86dp" />

                <!-- 보이는 칩 높이는 그대로, 터치 높이만 48dp (인셋 배경 + minHeight) -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/togglePassword"
                    style="@style/Gachi.Button.Ghost.Compact"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/space_md"
                    android:background="@drawable/bg_chip_neutral_touch"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="0dp"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="0dp"
                    android:text="@string/pw_show"
                    android:textColor="@color/gachi_neutral_ink" />
            </FrameLayout>

            <TextView
                android:id="@+id/passwordError"
                style="@style/Gachi.Text.FieldError"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/err_password" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/loginButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/login_cta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_2xl"
                android:paddingBottom="@dimen/space_xs">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/forgotButton"
                    style="@style/Gachi.Button.Link"
                    android:text="@string/login_forgot"
                    android:textColor="@color/gachi_ink_muted" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/signupButton"
                    style="@style/Gachi.Button.Link"
                    android:layout_marginStart="@dimen/space_lg"
                    android:text="@string/start_signup" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
