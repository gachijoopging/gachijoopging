<?xml version="1.0" encoding="utf-8"?>
<!-- M17 그룹 음성 통화 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/offlineBanner"
                style="@style/Gachi.Banner"
                android:background="@drawable/bg_banner_danger"
                android:visibility="gone">

                <TextView
                    android:id="@+id/bannerText"
                    style="@style/Gachi.Banner.Text"
                    android:text="@string/call_offline"
                    android:textColor="@color/gachi_danger_ink" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/reconnectButton"
                    style="@style/Gachi.Button.Ghost.Compact"
                    android:background="@drawable/bg_chip_danger_solid"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/call_reconnect"
                    android:textColor="@color/gachi_danger_bg" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:nestedScrollingEnabled="false" />

            <TextView
                style="@style/Gachi.Text.Micro"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:lineSpacingMultiplier="1.45"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/call_note"
                android:textColor="@color/gachi_ink_faint" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/muteButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_md" />

            <LinearLayout
                style="@style/Gachi.Card"
                android:layout_marginTop="@dimen/space_md">

                <TextView
                    style="@style/Gachi.Text.Section.Sm"
                    android:layout_marginBottom="@dimen/space_md"
                    android:text="@string/act_req_title" />

                <LinearLayout
                    android:id="@+id/requestBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tile_round"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_lg"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/space_lg"
                        android:paddingBottom="@dimen/space_md">

                        <TextView
                            android:id="@+id/requesterFace"
                            style="@style/Gachi.Avatar"
                            android:textSize="@dimen/text_metric" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/requesterName"
                                style="@style/Gachi.Text.ItemName" />

                            <TextView
                                android:id="@+id/requesterIntro"
                                style="@style/Gachi.Text.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/declineButton"
                            style="@style/Gachi.Button.Ghost"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:paddingTop="@dimen/space_md"
                            android:paddingBottom="@dimen/space_md"
                            android:text="@string/act_req_decline" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/acceptButton"
                            style="@style/Gachi.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:elevation="0dp"
                            android:paddingTop="@dimen/space_md"
                            android:paddingBottom="@dimen/space_md"
                            android:text="@string/act_req_accept"
                            android:textSize="@dimen/text_body" />
                    </LinearLayout>

                    <TextView
                        style="@style/Gachi.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/space_md"
                        android:lineSpacingMultiplier="1.45"
                        android:text="@string/act_req_note" />
                </LinearLayout>

                <TextView
                    android:id="@+id/requestResolved"
                    style="@style/Gachi.Text.Caption"
                    android:layout_width="match_parent"
                    android:lineSpacingMultiplier="1.5"
                    android:text="@string/act_req_resolved"
                    android:textColor="@color/gachi_ink_faint"
                    android:visibility="gone" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/leaveButton"
                style="@style/Gachi.Button.Ghost"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/call_leave" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
