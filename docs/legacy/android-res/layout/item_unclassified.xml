<?xml version="1.0" encoding="utf-8"?>
<!-- 미분류 수거 항목 (분류 칩 펼침 포함) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:background="@drawable/bg_unclassified_row"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_md"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/space_md"
    android:paddingBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_circle_avatar"
            android:backgroundTint="@color/gachi_warn_bg"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="🤔"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="@string/pickup_unclassified"
            android:textColor="@color/gachi_ink"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/editButton"
            style="@style/Gachi.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_surface_44"
            android:contentDescription="@string/cd_pickup_edit"
            android:padding="@dimen/space_lg"
            android:src="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/removeButton"
            style="@style/Gachi.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="0dp"
            android:background="@drawable/bg_circle_danger_44"
            android:contentDescription="@string/cd_pickup_remove"
            android:elevation="0dp"
            android:padding="@dimen/space_lg"
            android:src="@drawable/ic_trash"
            app:tint="@color/gachi_danger_ink" />
    </LinearLayout>

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/categoryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:visibility="gone"
        app:flexWrap="wrap" />
</LinearLayout>
