<?xml version="1.0" encoding="utf-8"?>
<!-- M06 모이깅 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <LinearLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Gachi.Text.PageTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/meet_title" />

        <FrameLayout
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/notiButton"
                style="@style/Gachi.IconButton"
                android:contentDescription="@string/cd_notification"
                android:src="@drawable/ic_bell" />

            <View
                android:id="@+id/notiDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/space_md"
                android:background="@drawable/bg_unread_dot"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="@color/gachi_shadow"
                android:outlineSpotShadowColor="@color/gachi_shadow"/>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabNow"
            style="@style/Gachi.Tab"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:text="@string/meet_tab_now" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabFind"
            style="@style/Gachi.Tab"
            android:layout_marginStart="@dimen/space_sm"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:text="@string/meet_tab_find" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabSched"
            style="@style/Gachi.Tab"
            android:layout_marginStart="@dimen/space_sm"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:text="@string/meet_tab_sched" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/nav_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- 지금 활동 -->
            <LinearLayout
                android:id="@+id/nowSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Gachi.Text.Caption.Strong"
                    android:paddingStart="@dimen/space_sm"
                    android:text="@string/meet_now_label" />

                <LinearLayout
                    android:id="@+id/activityList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical" />

                <!-- 활동이 하나도 없으면 통째로 숨긴다 (S15P11A702-236 G-24) -->
                <LinearLayout
                    android:id="@+id/moodSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Gachi.Text.Caption.Strong"
                        android:layout_marginTop="@dimen/space_sm"
                        android:paddingStart="@dimen/space_sm"
                        android:text="@string/meet_mood_label" />

                    <LinearLayout
                        android:id="@+id/busyToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@drawable/bg_tab_default"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_xl"
                        android:paddingTop="@dimen/space_lg"
                        android:paddingEnd="@dimen/space_xl"
                        android:paddingBottom="@dimen/space_lg">

                        <TextView
                            android:id="@+id/busyLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/gachi_ink_muted"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/busyCaret"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▾"
                            android:textColor="@color/gachi_ink_muted"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/busyList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/findMoreButton"
                    style="@style/Gachi.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/meet_find_more" />
            </LinearLayout>

            <!-- 모임 구하기 / 예정 모임 -->
            <LinearLayout
                android:clipChildren="false"
                android:id="@+id/listSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_search_pill"
                    android:elevation="3dp"
                    android:outlineAmbientShadowColor="@color/gachi_shadow"
                    android:outlineSpotShadowColor="@color/gachi_shadow"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingTop="@dimen/space_md"
                    android:paddingEnd="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_md">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/cd_search"
                        android:src="@drawable/ic_search_small" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/searchInput"
                        style="@style/Gachi.Input.Search"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:hint="@string/hint_meet_search" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/openMapSearch"
                    style="@style/Gachi.Button.Ghost"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/meet_open_map"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/filterRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    app:flexWrap="wrap" />

                <LinearLayout
                    android:id="@+id/meetList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/schedNote"
                    style="@style/Gachi.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_xs"
                    android:paddingStart="@dimen/space_sm"
                    android:text="@string/meet_sched_note"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/createButton"
                    style="@style/Gachi.Button.Primary"
                    android:layout_marginTop="@dimen/space_md"
                    android:paddingTop="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_lg"
                    android:text="@string/meet_create_new_plus"
                    android:textSize="@dimen/text_body_lg" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
