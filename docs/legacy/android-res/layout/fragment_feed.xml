<?xml version="1.0" encoding="utf-8"?>
<!-- M07 피드 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Gachi.Text.PageTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/feed_title" />

        <ImageButton
            android:id="@+id/searchButton"
            style="@style/Gachi.IconButton"
            android:contentDescription="@string/cd_search"
            android:src="@drawable/ic_search" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/writeButton"
            style="@style/Gachi.Button.Primary.Compact"
            android:layout_marginStart="@dimen/space_sm"
            android:drawableStart="@drawable/ic_plus_small"
            android:drawablePadding="6dp"
            android:paddingStart="@dimen/space_xl"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_md"
            android:text="@string/feed_write"
            android:textSize="@dimen/text_body_lg" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabAll"
            style="@style/Gachi.Tab"
            android:text="@string/feed_tab_all" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tabFriends"
            style="@style/Gachi.Tab"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/feed_tab_friend" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_anim_list"
            android:paddingBottom="@dimen/nav_scroll_padding"
            android:scrollbars="none" />

        <include layout="@layout/view_loading" />

        <include
            android:id="@+id/empty"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
