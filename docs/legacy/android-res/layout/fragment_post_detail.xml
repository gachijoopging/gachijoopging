<?xml version="1.0" encoding="utf-8"?>
<!-- M18 게시글 상세 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <!-- 삭제된 글 -->
    <include
        android:id="@+id/deleted"
        layout="@layout/view_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 본문 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:outlineAmbientShadowColor="@color/gachi_shadow"
                android:outlineSpotShadowColor="@color/gachi_shadow"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/authorRow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/ripple_tile"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_xs"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingEnd="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_md">

                        <TextView
                            android:id="@+id/face"
                            style="@style/Gachi.Avatar"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/name"
                                style="@style/Gachi.Text.ItemName" />

                            <TextView
                                android:id="@+id/meta"
                                style="@style/Gachi.Text.Caption"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/menuButton"
                        style="@style/Gachi.IconButton.Small"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_tint_36"
                        android:contentDescription="@string/cd_more"
                        android:padding="@dimen/space_lg"
                        android:src="@drawable/ic_more" />
                </LinearLayout>

                <site.gachijoopging.app.ui.common.ClipOutlineFrameLayout
                    android:id="@+id/photoFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_photo_placeholder"
                    android:minHeight="220dp">

                    <!--
                        사진이 없거나 못 그릴 때 남는 자리. 사진은 이 아이콘 위에 그려지므로
                        로딩 실패로 빈 이미지가 되면 다시 이 플레이스홀더가 보인다.
                    -->
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_photo"
                        app:tint="@color/gachi_ink_65" />

                    <!--
                        상세는 무엇을 올렸는지 확인하는 화면이라 사진을 자르지 않는다 —
                        `adjustViewBounds` + `fitCenter` 로 원본 비율을 지킨다
                        (AI 분류 확인 화면과 같은 이유). minHeight 220dp 는 가로로 긴 사진의
                        아래 여백, maxHeight 520dp 는 세로로 긴 사진이 본문을 화면 밖으로
                        밀어내지 않게 하는 상한이다.
                    -->
                    <ImageView
                        android:id="@+id/photo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/cd_post_photo"
                        android:maxHeight="520dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/photoIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/space_md"
                        android:background="@drawable/bg_pill_overlay"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="@dimen/space_xs"
                        android:textColor="@color/gachi_on_dark"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/prevPhoto"
                        style="@style/Gachi.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="0dp"
                        android:background="@drawable/bg_circle_surface_32"
                        android:contentDescription="@string/cd_photo_prev"
                        android:padding="@dimen/space_lg"
                        android:src="@drawable/ic_back"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/nextPhoto"
                        style="@style/Gachi.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="0dp"
                        android:background="@drawable/bg_circle_surface_32"
                        android:contentDescription="@string/cd_photo_next"
                        android:padding="@dimen/space_lg"
                        android:src="@drawable/ic_chevron_right"
                        android:visibility="gone" />
                </site.gachijoopging.app.ui.common.ClipOutlineFrameLayout>

                <TextView
                    android:id="@+id/text"
                    style="@style/Gachi.Text.Body"
                    android:layout_width="match_parent"
                    android:lineSpacingMultiplier="1.6"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingTop="@dimen/space_md"
                    android:paddingEnd="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_sm" />

                <LinearLayout
                    android:id="@+id/recordCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="@drawable/bg_tile_round"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingTop="@dimen/space_md"
                    android:paddingEnd="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_md"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/recordIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body_lg" />

                        <TextView
                            android:id="@+id/recordTitle"
                            style="@style/Gachi.Text.ItemName"
                            android:layout_width="0dp"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/recordZero"
                            style="@style/Gachi.Chip.Static.Warn"
                            android:paddingStart="@dimen/space_sm"
                            android:paddingTop="@dimen/space_xs"
                            android:paddingEnd="@dimen/space_sm"
                            android:paddingBottom="@dimen/space_xs"
                            android:text="@string/rec_zero_badge"
                            android:textSize="@dimen/text_micro"
                            android:visibility="gone" />
                    </LinearLayout>

                    <include
                        android:id="@+id/recordMetrics"
                        layout="@layout/view_record_metrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md" />

                    <TextView
                        android:id="@+id/recordMembers"
                        style="@style/Gachi.Text.Micro"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textColor="@color/gachi_ink_muted"
                        android:visibility="gone" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/thanksButton"
                    style="@style/Gachi.Chip.Choice"
                    app:drawableTint="@color/selector_chip_text"
                    android:layout_marginTop="@dimen/space_md"
                    android:drawableStart="@drawable/ic_heart_small"
                    android:drawablePadding="6dp" />
            </LinearLayout>

            <!-- 댓글 -->
            <LinearLayout
                style="@style/Gachi.Card"
                android:layout_marginTop="@dimen/space_md"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg">

                <TextView
                    android:id="@+id/commentLabel"
                    style="@style/Gachi.Text.Section" />

                <TextView
                    android:id="@+id/focusChip"
                    style="@style/Gachi.Chip.Static.Info"
                    android:layout_marginTop="@dimen/space_md"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/post_focus_chip"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/commentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/replyingChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_reply_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="0dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="0dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/replyingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gachi_green_text"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold" />

                    <!-- 보이는 20dp × 는 그대로, 터치 영역만 48dp (인셋 14dp 배경) -->
                    <ImageButton
                        android:id="@+id/replyCancel"
                        style="@style/Gachi.IconButton.Small"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="0dp"
                        android:contentDescription="@string/post_reply_cancel"
                        android:background="@drawable/bg_circle_neutral_20"
                        android:padding="@dimen/space_xl"
                        android:src="@drawable/ic_close" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/commentInput"
                        style="@style/Gachi.Input"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_pill"
                        android:hint="@string/hint_comment"
                        android:paddingStart="@dimen/space_lg"
                        android:paddingTop="@dimen/space_md"
                        android:paddingEnd="@dimen/space_lg"
                        android:paddingBottom="@dimen/space_md"
                        android:textSize="@dimen/text_label" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/sendComment"
                        style="@style/Gachi.Button.Primary.Compact"
                        android:layout_marginStart="@dimen/space_sm"
                        android:paddingTop="@dimen/space_md"
                        android:paddingBottom="@dimen/space_md"
                        android:text="@string/post_comment_send" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
