<?xml version="1.0" encoding="utf-8"?>
<!-- M27 모임 생성 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Text.Label"
                android:labelFor="@+id/titleInput"
                android:text="@string/label_meet_name" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/titleInput"
                style="@style/Gachi.Input"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/hint_meet_name" />

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@+id/placeInput"
                android:text="@string/label_place" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_md">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@string/cd_search"
                    android:src="@drawable/ic_search_small" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/placeInput"
                    style="@style/Gachi.Input.Search"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:hint="@string/hint_place"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/placeSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@+id/timeInput"
                android:text="@string/label_time" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/timeInput"
                style="@style/Gachi.Input"
                android:layout_marginTop="@dimen/space_sm"
                android:cursorVisible="false"
                android:hint="@string/hint_time"
                android:inputType="none" />

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/label_capacity" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_search_pill"
                android:elevation="3dp"
                android:outlineAmbientShadowColor="@color/gachi_shadow"
                android:outlineSpotShadowColor="@color/gachi_shadow"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_xs">

                <ImageButton
                    android:id="@+id/capacityMinus"
                    style="@style/Gachi.IconButton.Small"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_neutral_38"
                    android:contentDescription="@string/cd_capacity_minus"
                    android:padding="@dimen/space_lg"
                    android:src="@drawable/ic_minus" />

                <TextView
                    android:id="@+id/capacityValue"
                    style="@style/Gachi.Text.Section"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:gravity="center"
                    android:minWidth="44dp"
                    android:textSize="@dimen/text_subtitle" />

                <ImageButton
                    android:id="@+id/capacityPlus"
                    style="@style/Gachi.IconButton.Small"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_deep_38"
                    android:contentDescription="@string/cd_capacity_plus"
                    android:padding="@dimen/space_lg"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/gachi_yellow" />
            </LinearLayout>

            <TextView
                style="@style/Gachi.Text.Micro"
                android:layout_marginTop="@dimen/space_sm"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/mc_capacity_note"
                android:textColor="@color/gachi_ink_faint" />

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/label_visibility" />

            <LinearLayout
                android:id="@+id/visibilityList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/submitButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_button_cta"
                android:alpha="0.4"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_lg"
                android:text="@string/mc_cta"
                android:textSize="@dimen/text_body_lg" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
