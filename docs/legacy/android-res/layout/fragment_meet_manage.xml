<?xml version="1.0" encoding="utf-8"?>
<!-- M16 모임 관리 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Gachi.Card"
                android:padding="@dimen/space_xl">

                <TextView
                    android:id="@+id/heroMeta"
                    style="@style/Gachi.Text.Micro"
                    android:textColor="@color/gachi_ink_faint" />

                <TextView
                    android:id="@+id/title"
                    style="@style/Gachi.Text.PageTitle"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/placeTime"
                    style="@style/Gachi.Text.Caption" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/editInfo"
                    style="@style/Gachi.Button.Ghost.Compact"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_chip_neutral"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/mg_edit_info"
                    android:textColor="@color/gachi_neutral_ink"
                    android:textSize="@dimen/text_label"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                style="@style/Gachi.Card"
                android:layout_marginTop="@dimen/space_md">

                <TextView
                    android:id="@+id/memberCount"
                    style="@style/Gachi.Text.Section.Sm"
                    android:layout_marginBottom="@dimen/space_md" />

                <LinearLayout
                    android:id="@+id/memberList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Gachi.Text.Micro"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_md"
                    android:lineSpacingMultiplier="1.4"
                    android:text="@string/mg_location_note"
                    android:textColor="@color/gachi_ink_faint" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/chatButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card_translucent"
                android:foreground="@drawable/ripple_card_sm"
                android:elevation="2dp"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_lg"
                android:text="@string/mg_open_chat"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/endedNote"
                style="@style/Gachi.Text.Micro"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:lineSpacingMultiplier="1.4"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/mg_ended_note"
                android:textColor="@color/gachi_ink_faint"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/inviteButton"
                    style="@style/Gachi.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/mg_invite"
                    android:textSize="@dimen/text_body" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/primaryButton"
                    style="@style/Gachi.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_lg"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/leaveButton"
                style="@style/Gachi.Button.Link.Danger"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/mg_leave" />

            <TextView
                style="@style/Gachi.Text.Micro"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xs"
                android:lineSpacingMultiplier="1.4"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/mg_host_note"
                android:textColor="@color/gachi_ink_faint" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
