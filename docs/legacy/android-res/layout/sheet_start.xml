<?xml version="1.0" encoding="utf-8"?>
<!-- 하단 내비 '시작' → 어떻게 시작할까요? (프로토타입 startSheet) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_2xl">

    <View style="@style/Gachi.SheetHandle" />

    <TextView
        android:id="@+id/sheetTitle"
        style="@style/Gachi.Text.Section.Lg"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/start_sheet_title" />

    <LinearLayout
        android:id="@+id/optionSolo"
        style="@style/Gachi.SelectRow"
        android:layout_marginTop="@dimen/space_md">

        <TextView
            style="@style/Gachi.Avatar"
            android:importantForAccessibility="no"
            android:text="🌱"
            android:textSize="@dimen/text_metric" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Text.ItemName"
                android:text="@string/start_solo"
                android:textSize="@dimen/text_body" />

            <TextView
                style="@style/Gachi.Text.Caption"
                android:layout_marginTop="1dp"
                android:text="@string/start_solo_desc" />
        </LinearLayout>

        <View
            android:id="@+id/dotSolo"
            style="@style/Gachi.RadioDot" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionNearby"
        style="@style/Gachi.SelectRow"
        android:layout_marginTop="@dimen/space_sm">

        <TextView
            style="@style/Gachi.Avatar"
            android:importantForAccessibility="no"
            android:text="👋"
            android:textSize="@dimen/text_metric" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Text.ItemName"
                android:text="@string/start_nearby"
                android:textSize="@dimen/text_body" />

            <TextView
                style="@style/Gachi.Text.Caption"
                android:layout_marginTop="1dp"
                android:text="@string/start_nearby_desc" />
        </LinearLayout>

        <View
            android:id="@+id/dotNearby"
            style="@style/Gachi.RadioDot" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/acceptToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_tile"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/acceptSwitch"
            style="@style/Gachi.Switch"
            android:checked="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Text.ItemName"
                android:text="@string/start_accept_toggle" />

            <TextView
                style="@style/Gachi.Text.Caption"
                android:layout_marginTop="1dp"
                android:text="@string/start_accept_desc" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/locationToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_tile"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/locationSwitch"
            style="@style/Gachi.Switch"
            android:checked="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Text.ItemName"
                android:text="@string/start_location_toggle" />

            <TextView
                style="@style/Gachi.Text.Caption"
                android:layout_marginTop="1dp"
                android:text="@string/start_location_desc" />
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/startCta"
        style="@style/Gachi.Button.Primary"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/start_cta_solo"
        android:textSize="@dimen/text_subtitle" />
</LinearLayout>
