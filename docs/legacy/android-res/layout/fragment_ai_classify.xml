<?xml version="1.0" encoding="utf-8"?>
<!-- M11 AI 분류 확인 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <site.gachijoopging.app.ui.common.ClipOutlineFrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_photo_placeholder"
                android:minHeight="130dp"
                android:elevation="3dp"
                android:outlineAmbientShadowColor="@color/gachi_shadow"
                android:outlineSpotShadowColor="@color/gachi_shadow">

                <TextView
                    android:id="@+id/shotPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:text="🥤"
                    android:textSize="@dimen/text_counter" />

                <ImageView
                    android:id="@+id/shotPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/ai_shot_badge"
                    android:maxHeight="520dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="@dimen/space_md"
                    android:background="@drawable/bg_pill_overlay"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="@string/ai_shot_badge"
                    android:textColor="@color/gachi_on_dark"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold" />
            </site.gachijoopging.app.ui.common.ClipOutlineFrameLayout>

            <TextView
                android:id="@+id/failedBanner"
                style="@style/Gachi.Chip.Static.Danger"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_banner_danger"
                android:lineSpacingMultiplier="1.4"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_md"
                android:text="@string/ai_failed"
                android:textSize="@dimen/text_label"
                android:visibility="gone" />

            <!-- 미탐지는 정상 결과다 — danger 가 아니라 info 로 보여야 오류로 읽히지 않는다 -->
            <TextView
                android:id="@+id/infoBanner"
                style="@style/Gachi.Chip.Static.Info"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_banner_info"
                android:lineSpacingMultiplier="1.4"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_md"
                android:text="@string/ai_nothing_found"
                android:textSize="@dimen/text_label"
                android:visibility="gone" />

            <TextView
                android:id="@+id/uncertainBanner"
                style="@style/Gachi.Chip.Static.Warn"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_banner_warn"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_md"
                android:text="@string/ai_uncertain"
                android:textSize="@dimen/text_label"
                android:visibility="gone" />

            <TextView
                android:id="@+id/candidateTitle"
                style="@style/Gachi.Text.Section"
                android:layout_marginTop="@dimen/space_md"
                android:paddingStart="@dimen/space_xs"
                android:text="@string/ai_question" />

            <LinearLayout
                android:id="@+id/candidateList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/etcTitle"
                style="@style/Gachi.Text.Section"
                android:layout_marginTop="@dimen/space_lg"
                android:paddingStart="@dimen/space_xs"
                android:text="@string/ai_etc_title" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/etcRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:flexWrap="wrap" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/retakeButton"
                    style="@style/Gachi.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:paddingStart="@dimen/space_xl"
                    android:paddingEnd="@dimen/space_xl"
                    android:text="@string/ai_retake"
                    android:textSize="@dimen/text_body" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/confirmButton"
                    style="@style/Gachi.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_cta"
                    android:enabled="false"
                    android:text="@string/ai_cta"
                    android:textSize="@dimen/text_body_lg" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
