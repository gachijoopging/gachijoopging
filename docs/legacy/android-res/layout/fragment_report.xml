<?xml version="1.0" encoding="utf-8"?>
<!-- M32 신고하기 -->
<LinearLayout
    android:clipToPadding="false" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:id="@+id/formState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Text.Caption"
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/space_sm"
                android:paddingStart="@dimen/space_xs"
                android:text="@string/rp_desc" />

            <LinearLayout
                android:id="@+id/reasonList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/memoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_xs">

                    <TextView
                        style="@style/Gachi.Text.Label"
                        android:paddingStart="0dp"
                        android:text="@string/rp_etc_label" />

                    <TextView
                        style="@style/Gachi.Text.Label"
                        android:layout_marginStart="@dimen/space_xs"
                        android:paddingStart="0dp"
                        android:text="@string/rp_etc_required"
                        android:textColor="@color/gachi_danger_ink" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/memoInput"
                    style="@style/Gachi.Input.Multiline"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_input_multiline"
                    android:hint="@string/hint_report_etc"
                    android:minHeight="90dp"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/submitButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_button_cta"
                android:enabled="false"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_lg"
                android:text="@string/rp_submit"
                android:textSize="@dimen/text_body_lg" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:id="@+id/doneState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_2xl"
        android:paddingEnd="@dimen/space_2xl"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_surface"
            android:elevation="3dp"
            android:outlineAmbientShadowColor="@color/gachi_shadow"
            android:outlineSpotShadowColor="@color/gachi_shadow"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_lg"
            android:src="@drawable/ic_check"
            app:tint="@color/gachi_green_strong" />

        <TextView
            style="@style/Gachi.Text.Section.Lg"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/rp_done_title" />

        <TextView
            style="@style/Gachi.Text.Caption"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:lineSpacingMultiplier="1.6"
            android:text="@string/rp_done_desc" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/doneButton"
            style="@style/Gachi.Button.Primary.Compact"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/action_back_to"
            android:textSize="@dimen/text_body_lg" />
    </LinearLayout>
</LinearLayout>
