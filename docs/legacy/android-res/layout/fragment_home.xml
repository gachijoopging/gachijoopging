<?xml version="1.0" encoding="utf-8"?>
<!-- M05 홈 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_padding"
        android:paddingTop="@dimen/screen_top_padding"
        android:paddingEnd="@dimen/screen_h_padding">

        <!-- 상단: 로고 · 동네 · 알림 -->
        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/cd_logo"
                    android:src="@drawable/img_logo_wordmark" />

                <TextView
                    style="@style/Gachi.Text.Caption"
                    android:layout_marginTop="@dimen/space_xs"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_greeting" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hoodButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_xs">

                <TextView
                    android:id="@+id/hoodName"
                    style="@style/Gachi.Text.Section"
                    android:textSize="@dimen/text_subtitle" />

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>

            <FrameLayout
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm">

                <ImageButton
                    android:id="@+id/notiButton"
                    style="@style/Gachi.IconButton"
                    android:contentDescription="@string/cd_notification"
                    android:src="@drawable/ic_bell" />

                <View
                    android:id="@+id/notiDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/space_sm"
                    android:layout_marginEnd="@dimen/space_md"
                    android:background="@drawable/bg_unread_dot"
                    android:elevation="4dp"
                    android:outlineAmbientShadowColor="@color/gachi_shadow"
                    android:outlineSpotShadowColor="@color/gachi_shadow"/>
            </FrameLayout>
        </LinearLayout>

        <!-- 오프라인 배너 -->
        <LinearLayout
            android:id="@+id/offlineCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:outlineAmbientShadowColor="@color/gachi_shadow"
            android:outlineSpotShadowColor="@color/gachi_shadow"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_xl"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_lg"
            android:visibility="gone">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_avatar"
                android:backgroundTint="@color/gachi_danger_bg"
                android:gravity="center"
                android:text="!"
                android:textColor="@color/gachi_danger_ink"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Gachi.Text.ItemName"
                    android:maxLines="2"
                    android:text="@string/home_offline_title" />

                <TextView
                    style="@style/Gachi.Text.Caption"
                    android:layout_marginTop="1dp"
                    android:text="@string/home_offline_desc" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/retryButton"
                style="@style/Gachi.Button.Ghost.Compact"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_chip_neutral"
                android:text="@string/action_retry"
                android:textColor="@color/gachi_neutral_ink"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <!-- 이번 주 우리 동네 -->
        <LinearLayout
            android:id="@+id/weekCard"
            style="@style/Gachi.Card"
            android:layout_marginTop="@dimen/space_md"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_circle_deep"
                    android:contentDescription="@null"
                    android:padding="@dimen/space_sm"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/gachi_on_deep" />

                <TextView
                    style="@style/Gachi.Text.ItemName"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/home_week_title"
                    android:textSize="@dimen/text_body_lg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/weekCount"
                            style="@style/Gachi.Text"
                            android:textAppearance="@style/TextAppearance.Gachi.Counter" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:layout_marginBottom="@dimen/space_sm"
                            android:background="@drawable/bg_button_primary"
                            android:fontFamily="@font/pretendard"
                            android:textStyle="bold"
                            android:paddingStart="@dimen/space_md"
                            android:paddingTop="@dimen/space_xs"
                            android:paddingEnd="@dimen/space_md"
                            android:paddingBottom="@dimen/space_xs"
                            android:text="@string/unit_count"
                            android:textColor="@color/gachi_on_lime"
                            android:textSize="@dimen/text_body" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/weekSub"
                        style="@style/Gachi.Text.Caption"
                        android:layout_marginTop="@dimen/space_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_xs">

                    <LinearLayout
                        android:id="@+id/sparkline"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:gravity="bottom"
                        android:orientation="horizontal" />

                    <TextView
                        style="@style/Gachi.Text.Micro"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/home_spark_label" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 지도 -->
        <FrameLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1"
            android:minHeight="200dp">

            <include
                android:id="@+id/map"
                layout="@layout/view_map_frame" />

            <!-- 지도 상단 컨트롤 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/myOnlyChip"
                    style="@style/Gachi.Chip.Choice"
                    android:drawableStart="@drawable/ic_eye_small"
                    android:drawablePadding="6dp"
                    android:text="@string/home_my_only"
                    app:drawableTint="@color/selector_chip_text" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/replayButton"
                    style="@style/Gachi.Button.Deep"
                    android:layout_width="wrap_content"
                    android:drawableStart="@drawable/ic_play_small"
                    android:drawablePadding="6dp"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/home_replay"
                    android:textColor="@color/gachi_yellow"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>

            <!-- GPS 불안정 -->
            <LinearLayout
                android:id="@+id/gpsBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="@dimen/space_md"
                android:background="@drawable/bg_chip_warn"
                android:elevation="4dp"
                android:outlineAmbientShadowColor="@color/gachi_shadow"
                android:outlineSpotShadowColor="@color/gachi_shadow"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_gps_weak"
                    android:textColor="@color/gachi_warn_ink"
                    android:textSize="@dimen/text_label"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/gpsAllow"
                    style="@style/Gachi.Button.Ghost.Compact"
                    android:background="@drawable/bg_chip_warn_solid"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="@string/home_gps_allow"
                    android:textColor="@color/gachi_warn_bg" />
            </LinearLayout>
        </FrameLayout>

        <!-- 하단 두 카드 -->
        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="98dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nearbyCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_sm"
                android:elevation="3dp"
                android:outlineAmbientShadowColor="@color/gachi_shadow"
                android:outlineSpotShadowColor="@color/gachi_shadow"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_lg">

                <TextView
                    style="@style/Gachi.Text.Caption"
                    android:lineSpacingMultiplier="1.45"
                    android:text="@string/home_nearby_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nearbyCount"
                        style="@style/Gachi.Text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Gachi.Display"
                        android:textSize="@dimen/text_display" />

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_avatar"
                        android:backgroundTint="@color/gachi_deep"
                        android:contentDescription="@null"
                        android:padding="@dimen/space_md"
                        android:src="@drawable/ic_people"
                        app:tint="@color/gachi_lime" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nearbyMore"
                    style="@style/Gachi.Text.Caption.Strong"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mineCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:background="@drawable/bg_card_sm"
                android:elevation="3dp"
                android:outlineAmbientShadowColor="@color/gachi_shadow"
                android:outlineSpotShadowColor="@color/gachi_shadow"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_lg">

                <TextView
                    style="@style/Gachi.Text.Caption"
                    android:lineSpacingMultiplier="1.45"
                    android:text="@string/home_mine_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mineCount"
                        style="@style/Gachi.Text"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Gachi.Display"
                        android:textSize="@dimen/text_display" />

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_avatar"
                        android:backgroundTint="@color/gachi_orange"
                        android:contentDescription="@null"
                        android:padding="@dimen/space_md"
                        android:src="@drawable/ic_trash"
                        app:tint="@color/gachi_white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mineBreakdown"
                    style="@style/Gachi.Text.Caption.Strong"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 지도 전체화면 -->
    <FrameLayout
        android:id="@+id/mapFullLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gachi_bg"
        android:elevation="20dp"
        android:outlineAmbientShadowColor="@color/gachi_shadow"
        android:outlineSpotShadowColor="@color/gachi_shadow"
        android:visibility="gone">

        <include
            android:id="@+id/mapFull"
            layout="@layout/view_map_frame" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/mapFullClose"
                style="@style/Gachi.IconButton"
                android:contentDescription="@string/cd_close"
                android:src="@drawable/ic_close" />

            <TextView
                android:id="@+id/mapFullTitle"
                style="@style/Gachi.Chip.Static.Deep"
                android:layout_marginStart="@dimen/space_md"
                android:fontFamily="@font/pretendard"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                tools:text="역삼1동 지도" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
