<?xml version="1.0" encoding="utf-8"?>
<!-- M13 게시글 작성 / 수정 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Gachi.Text.Label"
                android:labelFor="@+id/bodyInput"
                android:text="@string/label_post_body" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/bodyInput"
                style="@style/Gachi.Input.Multiline"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_input_multiline"
                android:hint="@string/hint_post_body"
                android:maxLength="300" />

            <TextView
                android:id="@+id/counter"
                style="@style/Gachi.Text.Micro"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="end"
                android:paddingEnd="@dimen/space_sm" />

            <TextView
                android:id="@+id/photoLabel"
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/label_photo_pick" />

            <TextView
                android:id="@+id/editPhotoNote"
                style="@style/Gachi.Text.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xs"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/pub_edit_photo_note"
                android:visibility="gone" />


            <LinearLayout
                android:id="@+id/photoGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/label_record" />

            <LinearLayout
                android:id="@+id/recordCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_tile_round"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/recordIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_body_lg" />

                    <TextView
                        android:id="@+id/recordTitle"
                        style="@style/Gachi.Text.ItemName"
                        android:layout_width="0dp"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/recordZero"
                        style="@style/Gachi.Chip.Static.Warn"
                        android:paddingStart="@dimen/space_sm"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingEnd="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_xs"
                        android:text="@string/rec_zero_badge"
                        android:textSize="@dimen/text_micro"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/recordEdited"
                        style="@style/Gachi.Chip.Static"
                        android:layout_marginStart="@dimen/space_xs"
                        android:background="@drawable/bg_chip_neutral"
                        android:paddingStart="@dimen/space_sm"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingEnd="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_xs"
                        android:text="@string/rec_edited_badge"
                        android:textColor="@color/gachi_neutral_ink"
                        android:textSize="@dimen/text_micro"
                        android:visibility="gone" />
                </LinearLayout>

                <include
                    android:id="@+id/recordMetrics"
                    layout="@layout/view_record_metrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md" />

                <!--
                  피드에 함께 올라갈 요약 지도. 보여 주기만 하는 게 아니라 **이 지도를 그대로
                  떠서 이미지로 굽는다** (MapSnapshot). 그래서 공유 화면에 지도가 떠 있어야
                  하고, 올라간 그림은 여기 보이는 것과 같다.
                -->
                <include
                    android:id="@+id/map"
                    layout="@layout/view_map_frame"
                    android:layout_width="match_parent"
                    android:layout_height="248dp"
                    android:layout_marginTop="@dimen/space_md" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/removeRecord"
                style="@style/Gachi.Button.Link.Danger"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/pub_remove_record"
                android:visibility="gone" />

            <TextView
                android:id="@+id/noRecordNote"
                style="@style/Gachi.Text.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_sm"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/pub_no_record" />

            <LinearLayout
                android:id="@+id/scopeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/scopeMine"
                    style="@style/Gachi.SelectRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Gachi.Text.ItemName"
                            android:text="@string/pub_scope_mine" />

                        <TextView
                            style="@style/Gachi.Text.Caption"
                            android:text="@string/pub_scope_mine_desc" />
                    </LinearLayout>

                    <View
                        android:id="@+id/scopeMineDot"
                        style="@style/Gachi.RadioDot" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scopeAll"
                    style="@style/Gachi.SelectRow"
                    android:layout_marginTop="@dimen/space_sm">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Gachi.Text.ItemName"
                            android:text="@string/pub_scope_all" />

                        <TextView
                            style="@style/Gachi.Text.Caption"
                            android:text="@string/pub_scope_all_desc" />
                    </LinearLayout>

                    <View
                        android:id="@+id/scopeAllDot"
                        style="@style/Gachi.RadioDot" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Gachi.Text.Label"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/label_visibility" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/visibilityRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:flexWrap="wrap" />

            <TextView
                android:id="@+id/needNote"
                style="@style/Gachi.Text.Caption"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xs"
                android:paddingStart="@dimen/space_sm"
                android:text="@string/pub_need_note"
                android:textColor="@color/gachi_warn_ink"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/skipButton"
                    style="@style/Gachi.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_lg"
                    android:text="@string/pub_skip"
                    android:textSize="@dimen/text_body_lg" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/submitButton"
                    style="@style/Gachi.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_cta"
                    android:enabled="false"
                    android:paddingTop="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_lg"
                    android:text="@string/pub_cta_new"
                    android:textSize="@dimen/text_body_lg" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
