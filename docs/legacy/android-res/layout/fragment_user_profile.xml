<?xml version="1.0" encoding="utf-8"?>
<!-- M20 타인 프로필 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_h_padding">

    <include
        android:id="@+id/header"
        layout="@layout/view_screen_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/plain_scroll_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs">

                <TextView
                    android:id="@+id/face"
                    style="@style/Gachi.Avatar.Large"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:contentDescription="@string/cd_avatar"
                    android:textSize="32sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/name"
                        style="@style/Gachi.Text.PageTitle"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/intro"
                        style="@style/Gachi.Text.Caption"
                        android:layout_marginTop="@dimen/space_xs" />

                    <TextView
                        android:id="@+id/stats"
                        style="@style/Gachi.Text.Caption"
                        android:layout_marginTop="@dimen/space_sm" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/blockedBanner"
                style="@style/Gachi.Chip.Static.Danger"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_banner_danger"
                android:lineSpacingMultiplier="1.4"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_md"
                android:text="@string/up_blocked"
                android:textSize="@dimen/text_label"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/friendButton"
                style="@style/Gachi.Button.Primary"
                android:layout_marginTop="@dimen/space_md"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="@dimen/space_md"
                android:textSize="@dimen/text_body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_sm">

                <TextView
                    style="@style/Gachi.Text.Caption.Strong"
                    android:text="@string/up_public_posts" />

                <TextView
                    style="@style/Gachi.Text.Micro"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_marginBottom="1dp"
                    android:text="@string/up_public_posts_note"
                    android:textColor="@color/gachi_ink_faint"
                    android:textStyle="normal" />
            </LinearLayout>

            <include layout="@layout/view_loading" />

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/postGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
