<?xml version="1.0" encoding="utf-8"?>
<!--
  화면 공통 배경의 야간 변형.

  라이트 버전은 노랑·흰색 글로우를 각각 50%·55% 알파로 얹습니다. 같은 값을 어두운
  바탕에 올리면 화면 절반이 밝게 떠서 카드보다 배경이 더 눈에 띕니다.
  그래서 글로우 색을 라임으로 바꾸고 알파를 1/3 수준으로 낮춰, 어둠 속에서 은은한
  빛무리 정도만 남겼습니다. 위치와 크기는 라이트와 동일합니다.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gachi_bg" />
        </shape>
    </item>
    <item
        android:bottom="420dp"
        android:left="130dp"
        android:right="-130dp"
        android:top="-90dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#14C9E345"
                android:endColor="#00C9E345"
                android:gradientRadius="180dp"
                android:startColor="#2BC9E345"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:bottom="180dp"
        android:left="-160dp"
        android:right="150dp"
        android:top="160dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#12FFFFFF"
                android:endColor="#00FFFFFF"
                android:gradientRadius="200dp"
                android:startColor="#22FFFFFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
