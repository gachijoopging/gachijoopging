<?xml version="1.0" encoding="utf-8"?>
<!-- 리스트 항목 하나가 처음 나타날 때. 아래에서 살짝 올라오며 페이드인. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha
        android:duration="220"
        android:fromAlpha="0"
        android:interpolator="@interpolator/standard_easing"
        android:toAlpha="1" />
    <translate
        android:duration="260"
        android:fromYDelta="12%"
        android:interpolator="@interpolator/emphasized_decelerate"
        android:toYDelta="0" />
</set>
