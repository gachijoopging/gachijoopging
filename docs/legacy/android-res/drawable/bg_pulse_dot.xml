<?xml version="1.0" encoding="utf-8"?>
<!-- 현재 위치 표시 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/gachi_lime_35" />
        </shape>
    </item>
    <item android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:endColor="@color/gachi_yellow"
                android:startColor="@color/gachi_lime" />
            <stroke android:width="3dp" android:color="@color/gachi_surface" />
        </shape>
    </item>
</layer-list>
