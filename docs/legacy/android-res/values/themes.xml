<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Gachi" parent="Theme.Material3.DayNight.NoActionBar">
        <!--
          values-night 에 직접 설계한 팔레트가 있으므로, OS 의 자동 색 반전은 계속 막는다.
          자동 반전은 브랜드 색을 기계적으로 뒤집어 올리브 톤을 회색으로 만든다.
        -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="colorPrimary">@color/gachi_deep</item>
        <item name="colorOnPrimary">@color/gachi_on_deep</item>
        <item name="colorPrimaryContainer">@color/gachi_lime</item>
        <item name="colorOnPrimaryContainer">@color/gachi_on_lime</item>

        <item name="colorSecondary">@color/gachi_green_text</item>
        <item name="colorOnSecondary">@color/gachi_surface</item>

        <item name="colorSurface">@color/gachi_surface</item>
        <item name="colorOnSurface">@color/gachi_ink</item>
        <item name="colorSurfaceVariant">@color/gachi_neutral</item>
        <item name="colorOnSurfaceVariant">@color/gachi_ink_muted</item>

        <item name="colorError">@color/gachi_error</item>
        <item name="colorOutline">@color/gachi_border</item>

        <item name="android:colorBackground">@color/gachi_bg</item>
        <item name="android:textColorPrimary">@color/gachi_ink</item>
        <item name="android:textColorSecondary">@color/gachi_ink_muted</item>
        <item name="android:textColorHint">@color/gachi_ink_hint</item>

        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>

        <item name="bottomSheetDialogTheme">@style/Theme.Gachi.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/Theme.Gachi.Dialog</item>
    </style>

    <!--
      BottomSheetDialog 는 액티비티 테마를 물려받지 않는 별도 테마라,
      브랜드 서피스 색을 여기서 한 번 더 지정해야 Material3 기본 톤으로 새지 않습니다.
    -->
    <style name="Theme.Gachi.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="bottomSheetStyle">@style/Widget.Gachi.BottomSheet</item>
        <item name="colorSurface">@color/gachi_surface</item>
        <item name="colorSurfaceContainerLow">@color/gachi_surface</item>
        <item name="colorOnSurface">@color/gachi_ink</item>
        <item name="colorOnSurfaceVariant">@color/gachi_ink_muted</item>
        <item name="android:navigationBarColor">@color/gachi_surface</item>
    </style>

    <style name="Widget.Gachi.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/gachi_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Gachi.Sheet</item>
        <item name="behavior_peekHeight">auto</item>
    </style>

    <style name="ShapeAppearance.Gachi.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_sheet</item>
        <item name="cornerSizeTopRight">@dimen/radius_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.Gachi.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/Widget.Gachi.AlertDialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Gachi.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Gachi.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Gachi.DialogButton.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Gachi.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Gachi.DialogButton</item>
    </style>

    <!--
      확인 모달의 알약 버튼 (Dialogs.kt Confirm 주석의 "두 개의 알약 버튼" 대응).
      실행(positive)은 라임 알약, 취소(negative/neutral)는 텍스트 버튼.
    -->
    <style name="Widget.Gachi.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/gachi_ink_muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="rippleColor">@color/gachi_lime_28</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Gachi.Pill</item>
    </style>

    <style name="Widget.Gachi.DialogButton.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/gachi_lime</item>
        <item name="android:textColor">@color/gachi_on_lime</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="rippleColor">@color/gachi_lime_35</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Gachi.Pill</item>
    </style>

    <style name="ShapeAppearance.Gachi.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Gachi.AlertDialog" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Gachi.Dialog</item>
        <item name="backgroundTint">@color/gachi_surface</item>
    </style>

    <style name="ShapeAppearance.Gachi.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <style name="TextAppearance.Gachi.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/gachi_ink</item>
    </style>

    <style name="TextAppearance.Gachi.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingMultiplier">1.55</item>
        <item name="android:textColor">@color/gachi_ink_muted</item>
    </style>
</resources>
