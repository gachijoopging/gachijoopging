* text=auto

# 셸 스크립트·컨테이너 설정은 체크아웃에서도 LF. CRLF 면 Linux 가 bad interpreter 로 죽는다
*.sh          text eol=lf
gradlew       text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
.env          text eol=lf
.env.*        text eol=lf

# 약관 HTML 은 infra/legal/build.mjs 가 LF 로 만든다. 체크아웃에서 CRLF 가 되면
# --check 가 Windows 에서만 항상 어긋난다 — 그 실패를 전문이 바뀐 것으로 읽게 된다
infra/legal/*.html  text eol=lf
*.mjs         text eol=lf

# Windows 전용 스크립트는 CRLF
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# 바이너리
*.jks  binary
*.keystore binary
*.jar  binary
*.pt   binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ttf  binary
*.otf  binary
*.mp4  binary
