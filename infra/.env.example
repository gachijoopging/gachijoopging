# operations.md 의 키 목록. 실물 값은 EC2 의 /opt/gachijoopging/infra/.env 한 곳에만 둔다.
# 이 파일을 복사해 채운 뒤에는 dev-env.ps1 같은 스크립트로 올린다 — Windows 편집기로 열면
# PEM 값에 CR 이 섞이고, docker compose 는 통과시키지만 Spring 만 Missing key encoding 으로 죽는다.

# 이미지 좌표. IMAGE_TAG 는 deploy.sh 가 갱신한다
DOCKERHUB_USER=
IMAGE_TAG=

# 서명 URL·메일 링크의 기준. apex 는 301 이라 쓰지 않는다
PUBLIC_BASE_URL=https://www.gachi-joopging.site

# Supabase Postgres (ADR-0001). 옛 POSTGRES_* 는 컨테이너용이라 없다
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# 토큰 서명. PREVIOUS 는 kid 회전 중에만 채운다
JWT_ACTIVE_KID=
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_PREVIOUS_KID=
JWT_PREVIOUS_PUBLIC_KEY_PEM=

# 소셜 토큰 검증
KAKAO_REST_API_KEY=
KAKAO_APP_ID=
GOOGLE_CLIENT_ID=

# 사진 서명 URL
MEDIA_SECURE_LINK_SECRET=

# 비밀번호 재설정 메일
MAIL_USERNAME=
MAIL_PASSWORD=

# 푸시. Firebase 프로젝트 gachi-joopging, Android 패키지 site.gachijoopging.app
FCM_CREDENTIALS=

# AI 서버 (담당자 노트북)
AI_BASE_URL=
AI_SECRET=

# acme
CERT_DOMAIN=
CERT_EMAIL=

# Mattermost 알림 — 각자 자기 것을 발급받아 자기 infra/.env 에 넣는다. 저장소에 올리지 않는다.
#
#   발급: Mattermost 좌상단 메뉴 → 통합(Integrations) → 들어오는 웹후크(Incoming Webhooks)
#         → 웹후크 추가 → 제목과 올릴 채널 선택 → 저장 → 나오는 URL 을 복사
#         메뉴에 통합이 없으면 팀 관리자에게 웹후크 생성 권한을 요청한다
#
#   보내기: node infra/notify.mjs "메시지"
#
# GitHub Actions 는 이 값을 쓰지 않는다 — 레포 Secret 의 MM_WEBHOOK_URL 을 쓴다.
MM_WEBHOOK_URL=
