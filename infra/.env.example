# operations.md 의 키 목록. 실물 값은 서버의 /opt/gachijoopging/infra/.env 한 곳에만 둔다.
# 이 파일을 복사해 채운 뒤에는 dev-env.ps1 같은 스크립트로 올린다 — Windows 편집기로 열면
# PEM 값에 CR 이 섞이고, docker compose 는 통과시키지만 Spring 만 Missing key encoding 으로 죽는다.
#
# 백엔드가 ${...} 로 읽는 이름과 여기 이름이 1:1 이어야 한다. 어긋나면 기동에서 죽는다.

# 이미지 좌표. IMAGE_TAG 는 deploy.sh 가 갱신한다
DOCKERHUB_USER=
IMAGE_TAG=

# 서명 URL·메일 링크의 기준. apex 는 301 이라 쓰지 않는다
PUBLIC_BASE_URL=https://www.gachijoopging.site

# 초대 링크 앞부분. 카카오톡으로 공유되는 주소다
INVITE_BASE_URL=https://www.gachijoopging.site/invite

# Supabase Postgres (ADR-0001). 옛 POSTGRES_* 는 컨테이너용이라 없다
DATABASE_URL=
DATABASE_USER=
# $ 가 든 값은 $$ 로 적는다 — compose 가 env_file 값도 보간한다 (operations.md §배포)
DATABASE_PASSWORD=

# Redis. 지금 쓰는 곳은 레이트리밋(global/ratelimit) 하나다.
# STOMP 브로커 릴레이·채팅 pub/sub 은 아직 코드에 없다.
REDIS_HOST=
REDIS_PORT=6379
# 운영은 필수. compose 가 --requirepass 로 건다. $ 가 섞이지 않게 openssl rand -hex 32 로 만든다
REDIS_PASSWORD=

# 토큰 서명. PREVIOUS 는 kid 회전 중에만 채운다
JWT_ACTIVE_KID=
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_PREVIOUS_KID=
JWT_PREVIOUS_PUBLIC_KEY_PEM=

# 소셜 토큰 검증
KAKAO_APP_ID=
GOOGLE_CLIENT_ID=

# 사진. MEDIA_ROOT 는 컨테이너 안 경로이고 compose 가 볼륨으로 디스크에 잇는다
MEDIA_ROOT=/data/uploads
MEDIA_SECURE_LINK_SECRET=

# 비밀번호 재설정 메일
MAIL_USERNAME=
MAIL_PASSWORD=

# 푸시. Firebase 프로젝트 gachi-joopging, Android 패키지 site.gachijoopging.app
FCM_CREDENTIALS=

# AI 서버 (담당자 노트북). AI_BASE_URL 은 ai/.env 의 NGROK_DOMAIN 앞에 https:// 를 붙인 값,
# AI_SECRET 은 ai/.env 의 같은 이름과 같은 값이어야 한다 — 다르면 호출이 전부 401 인데
# 백엔드가 401 을 UNAVAILABLE 로 내려 "AI 서버 다운" 과 구별되지 않는다
AI_BASE_URL=
AI_SECRET=

# acme
CERT_DOMAIN=
CERT_EMAIL=

# 동의 전문. 아직 백엔드가 읽지 않는다 — 동의 API 를 구현할 때 들어온다.
# 전문 정본은 docs/legal/ 이고 버전은 각 문서 머리의 값. 정식 주소 전환은 GAC-80
AGREEMENTS_VERSION=
TERMS_URL=
PRIVACY_URL=
MARKETING_URL=
