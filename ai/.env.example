# ai/.env 로 복사해서 쓴다. `.env` 는 커밋되지 않는다(.gitignore).
# imgsz 는 여기에 없다 — 학습·추론 동일이 유일한 절대 조건이라 코드에 고정했다(app/config.py).

# 필수. 없으면 서버가 뜨지 않는다.
# 터널 URL 은 공개되므로 시크릿이 없으면 누구나 GPU 를 쓴다(서버설계 결정 29).
# 백엔드 배포 환경(infra/.env 의 AI_SECRET)과 같은 값이어야 한다. 팀이 쓰는 값이 있으면 받아서 넣는다 —
# 새로 만들면 호출이 전부 401 인데, 백엔드가 401 을 UNAVAILABLE 로 내려 "AI 서버 다운"과 구별되지 않는다.
#   값을 처음 정할 때만: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SECRET=

# ngrok 이 계정마다 자동 배정하는 dev 도메인. 재시작해도 같은 주소라 백엔드 설정을
# 다시 고칠 일이 없다 — 결정 29 가 데모 사고 1순위로 꼽은 자리다.
#   대시보드에서 확인: https://dashboard.ngrok.com/domains
# 이 값을 읽는 스크립트는 없다. 손으로 넘긴다:
#   ngrok http 8000 --url=https://<이 값>
# 백엔드에도 같은 값을 넘긴다 — infra/.env 의 AI_BASE_URL 이 https://<이 값> 이다.
# 넘기지 않으면 그쪽이 빈 채로 남고, 백엔드는 호출을 건너뛰어 UNAVAILABLE 만 낸다.
# authtoken 은 여기 두지 않는다 — `ngrok config add-authtoken` 이 ngrok 자체 설정에 저장한다.
NGROK_DOMAIN=

# 이하 선택 (기본값이 주석의 값)
#AI_WEIGHTS=weights/yolo26s-1024-v1.pt
#AI_DEVICE=0
# weights 파일명과 같은 값. 보정 맵이 바뀌면 weights 가 그대로여도 v2 로 올린다.
#AI_MODEL_VERSION=yolo26s-1024-v1
# 이 값 미만은 items 에 넣지 않는다. 데모는 0.25 그대로 간다(실측은 범위 밖, progress.md §2 W4).
# 0.7 이상은 넣을 수 없다 — unclassified 플로우가 죽은 코드가 된다(README §3.3).
#AI_CONF_MIN=0.25
