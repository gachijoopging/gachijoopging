{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify-push.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gachi@gachi": true
  },
  "extraKnownMarketplaces": {
    "gachi": {
      "source": {
        "source": "git",
        "url": "https://github.com/gachijoopging/gachijoopging.git",
        "ref": "dev"
      },
      "autoUpdate": true
    }
  }
}
